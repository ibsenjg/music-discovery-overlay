{
  "manifest_version": 3,
  "name": "Music Discovery Overlay",
  "version": "0.1.0",
  "description": "Build exploratory, evidence-labelled music searches locally on Spotify Web.",
  "minimum_chrome_version": "149",
  "icons": {
    "16": "icons/aurora-16.png",
    "32": "icons/aurora-32.png",
    "48": "icons/aurora-48.png",
    "128": "icons/aurora-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://open.spotify.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["frame/index.html", "assets/*"],
      "matches": ["https://open.spotify.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors https://open.spotify.com"
  }
}
